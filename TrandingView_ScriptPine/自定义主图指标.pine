// ========== Historical Pivot Points（精简版，仅保留核心水平，避免超过 64 plot 限制）==========
plot(FIB_Active and i_histPP and show_0 ? math.avg(htf_h1, htf_l1, htf_c1) : na, 
     "PP", bool(ta.change(time(htf))) ? na : color_0, editable=false, display=display)

plot(FIB_Active and i_histPP and show_0_382 ? math.avg(htf_h1, htf_l1, htf_c1) - (htf_h1 - htf_l1) * value_0_382 : na, 
     "PP 0.382 S", bool(ta.change(time(htf))) ? na : color_0_382, editable=false, display=display)
plot(FIB_Active and i_histPP and show_0_382 ? math.avg(htf_h1, htf_l1, htf_c1) + (htf_h1 - htf_l1) * value_0_382 : na, 
     "PP 0.382 R", bool(ta.change(time(htf))) ? na : color_0_382, editable=false, display=display)

plot(FIB_Active and i_histPP and show_0_618 ? math.avg(htf_h1, htf_l1, htf_c1) - (htf_h1 - htf_l1) * value_0_618 : na, 
     "PP 0.618 S", bool(ta.change(time(htf))) ? na : color_0_618, editable=false, display=display)
plot(FIB_Active and i_histPP and show_0_618 ? math.avg(htf_h1, htf_l1, htf_c1) + (htf_h1 - htf_l1) * value_0_618 : na, 
     "PP 0.618 R", bool(ta.change(time(htf))) ? na : color_0_618, editable=false, display=display)

